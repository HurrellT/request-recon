{
  "manifest_version": 3,
  "name": "Request Recon",
  "version": "1.0.0",
  "minimum_chrome_version": "118",
  "default_locale": "es",
  "description": "__MSG_extensionDescription__",
  "icons": {
    "16": "assets/request-recon-logo-sm.png",
    "32": "assets/request-recon-logo-sm.png",
    "48": "assets/request-recon-logo-sm.png",
    "128": "assets/request-recon-logo.png"
  },
  "permissions": [
    "debugger",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "devtools_page": "devtools/devtools.html",
  "action": {
    "default_icon": {
      "16": "assets/request-recon-logo-sm.png",
      "32": "assets/request-recon-logo-sm.png"
    },
    "default_popup": "popup/index.html",
    "default_title": "Request Recon"
  }
}
